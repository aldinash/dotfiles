[init]
    defaultBranch = main
[core]
    autocrlf = input
    safecrlf = warn
    excludesFile = ~/.config/git/ignore
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[color]
    ui = auto
[pull]
    ff = only
[push]
    autoSetupRemote = true
[merge]
    conflictStyle = zdiff3
[include]
    path = ~/.config/git/local
